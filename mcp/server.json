{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Enigma-52/workway",
  "description": "Search 490k+ live jobs from company ATS boards, save roles, follow companies, manage talent profile.",
  "version": "1.0.0",
  "websiteUrl": "https://docs.workway.dev",
  "repository": {
    "url": "https://github.com/Enigma-52/WorkWay--BE",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.workway.dev/api/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <workway-api-key>. Generate a key at https://workway.dev/dashboard/seeker/api-keys",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
